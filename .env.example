# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32
# (Use letters/digits only for the MongoDB passwords; they go into a connection URL.)

# ---------- Site ----------
# Public address of the site, used in emailed links.
PUBLIC_URL=https://idealab.reva.edu.in
# At least 32 random characters. Changing it signs everyone out.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Only Microsoft accounts with this email domain can sign in.
UNIVERSITY_EMAIL_DOMAIN=reva.edu.in

# ---------- Sign-in: Microsoft (REVA's Microsoft 365 / Entra ID) ----------
# From the app registration in portal.azure.com (see DEPLOYMENT.md section 3).
# Redirect URI to register there: <PUBLIC_URL>/api/auth/microsoft/callback
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ---------- Sign-in: Google (visitors outside REVA, general access) ----------
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI: <PUBLIC_URL>/api/auth/google/callback  (DEPLOYMENT.md section 3b)
# Leave empty to turn Google sign-in off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- MongoDB (docker compose creates these users on first start) ----------
MONGODB_DB=idealab
# Separate database for the sign-in log (the app can only add to it, never edit it).
MONGODB_AUDIT_DB=idealab_audit
# Separate database for the Google sign-in log (same append-only rules).
MONGODB_GOOGLE_AUDIT_DB=idealab_audit_google
# Separate database for the email + password sign-in log (same append-only rules).
MONGODB_PASSWORD_AUDIT_DB=idealab_audit_password
MONGO_ROOT_USER=idealab_root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=idealab_app
MONGO_APP_PASSWORD=
# Only when running the app outside docker compose, e.g. local development:
# MONGODB_URI=mongodb://127.0.0.1:27017

# ---------- Email: Amazon SES ----------
# A sender address (or domain) verified in SES. The EC2 instance role provides the
# credentials (ses:SendEmail); no keys are needed here. Unset = emails are only logged.
EMAIL_FROM=IDEA Lab <no-reply@idealab.reva.edu.in>
AWS_REGION=ap-south-1

# ---------- Payments: Razorpay (3D print orders) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Optional ----------
# Only if the frontend is served from a different origin than the API.
CORS_ORIGINS=
# Which proxies to trust for client IPs (default: loopback/private addresses).
TRUST_PROXY=
# Per public IP address. A whole campus can share one address, so keep this generous.
RATE_LIMIT_PER_MINUTE=6000
# Email + password sign-in / sign-up per IP per minute (accounts also lock after 10 wrong passwords).
PASSWORD_RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=60
# Where uploaded files are stored when running outside docker compose.
# STORAGE_DIR=./data/uploads

# ---------- One-time migration from the old Supabase project (see DEPLOYMENT.md) ----------
# SUPABASE_DB_URL=postgresql://postgres.<project>:<password>@<host>:5432/postgres
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
